{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyChatHistoryTable",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/acme-genai-chat-history",
      "Condition": {
        "StringEquals": { "aws:PrincipalAccount": "<ACCOUNT_ID>" }
      }
    }
  ]
}
