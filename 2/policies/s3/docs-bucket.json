{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "G9DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::acme-genai-docs-<ACCOUNT_ID>",
        "arn:aws:s3:::acme-genai-docs-<ACCOUNT_ID>/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
